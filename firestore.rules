rules_version = '2';

// Regole di sicurezza per il progetto Firebase di EduTime Pro.
//
// Modello: un documento per scuola dentro la collezione eduTimeApp_v6.
// L'id del documento è il "codice scuola" e funziona come una password:
// per questo le regole permettono di leggere un documento di cui si conosce
// già l'id, ma vietano di elencare la collezione (niente enumerazione dei
// codici altrui) e vietano la cancellazione.

service cloud.firestore {
  match /databases/{database}/documents {

    match /eduTimeApp_v6/{codiceScuola} {

      // Lettura del singolo documento: serve conoscere il codice esatto.
      allow get: if request.auth != null
                 && codiceScuola.size() >= 12;

      // Nessuna query sulla collezione: i codici non sono scopribili.
      allow list: if false;

      // Scrittura: solo i campi previsti dall'app.
      //
      // ATTENZIONE: questo elenco va tenuto uguale a CLOUD_FIELDS in
      // src/workspace.ts. Se l'app manda un campo che non c'è qui, Firestore
      // rifiuta TUTTO il salvataggio (permission-denied) e la scuola non
      // salva più niente, non solo il campo nuovo. Ogni volta che si aggiunge
      // un dato al documento vanno aggiornati tutti e due i posti, e le
      // regole vanno ripubblicate dalla console Firebase.
      allow create, update: if request.auth != null
        && codiceScuola.size() >= 12
        && request.resource.data.keys().hasOnly([
             'timetable',
             'teachers',
             'sostegno',
             'sectionsConfig',
             'generationRules',
             'generateOptions',
             'strumento',
             'diurnalHours',
             'afternoonHours',
             'cellNotes',
             'groupConstraints',
             'mixedClasses',
             'rooms',
             'modelGrids',
             'sedi',
             'absences',
             'substitutions',
             'assemblee',
             'personaleExtra',
             'assembleeConfig',
             'consigli',
             'consigliConfig',
             'lastUpdatedAt',
             'lastUpdatedBy'
           ]);

      // I dati non si cancellano dall'app.
      allow delete: if false;
    }

    // Tutto il resto del database è chiuso.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
